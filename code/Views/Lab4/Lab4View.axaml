<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:code.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="code.Views.Lab4View"
             x:DataType="vm:Lab4ViewModel">
  <ScrollViewer>
    <Border Padding="20">
      <StackPanel Spacing="15" MaxWidth="800">
        <StackPanel Spacing="8">
          <TextBlock Text="Лабораторна робота №4" 
                     FontSize="24" 
                     FontWeight="Bold"/>
          <TextBlock Text="Шифрування файлів за алгоритмом RSA"
                     FontSize="14"
                     Foreground="Gray"/>
        </StackPanel>

        <Border Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="15">
          <StackPanel Spacing="10">
            <TextBlock Text="Режим роботи:" FontWeight="SemiBold" Foreground="White"/>
            <StackPanel Orientation="Horizontal" Spacing="15">
              <RadioButton Content="Генерація ключів" 
                          IsChecked="{Binding IsGenerateMode}"
                          GroupName="Mode"
                          Foreground="White"/>
              <RadioButton Content="Шифрування" 
                          IsChecked="{Binding IsEncryptMode}"
                          GroupName="Mode"
                          Foreground="White"/>
              <RadioButton Content="Дешифрування" 
                          IsChecked="{Binding IsDecryptMode}"
                          GroupName="Mode"
                          Foreground="White"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Режим генерації ключів -->
        <Border Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="15"
                IsVisible="{Binding IsGenerateMode}">
          <StackPanel Spacing="12">
            <TextBlock Text="Параметри генерації ключів:" FontWeight="SemiBold" Foreground="White"/>
            
            <StackPanel Spacing="5">
              <TextBlock Text="Розмір ключа (біт):" Foreground="White"/>
              <ComboBox SelectedItem="{Binding KeySizeInBits}" Width="200" HorizontalAlignment="Left">
                <sys:Int32>2048</sys:Int32>
                <sys:Int32>3072</sys:Int32>
                <sys:Int32>4096</sys:Int32>
              </ComboBox>
              <TextBlock Text="Рекомендовано: 2048 біт (швидше) або 4096 біт (безпечніше)"
                        FontSize="12"
                        Foreground="Gray"
                        FontStyle="Italic"/>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="Розташування для збереження ключів:" Foreground="White"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding KeyFilePath}"
                        IsReadOnly="True"
                        Watermark="Натисніть 'Вибрати' для вибору розташування"/>
                <Button Grid.Column="1"
                        Content="Вибрати..."
                        Command="{Binding SelectKeyLocationCommand}"
                        Margin="5,0,0,0"/>
              </Grid>
              <TextBlock Text="Буде створено два файли: [назва].pub (публічний) і [назва] (приватний)"
                        FontSize="12"
                        Foreground="Gray"
                        FontStyle="Italic"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Режим шифрування -->
        <Border Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="15"
                IsVisible="{Binding IsEncryptMode}">
          <StackPanel Spacing="12">
            <TextBlock Text="Налаштування шифрування:" FontWeight="SemiBold" Foreground="White"/>
            
            <StackPanel Spacing="5">
              <TextBlock Text="Публічний ключ:" Foreground="White"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding KeyFilePath}"
                        IsReadOnly="True"
                        Watermark="Виберіть публічний ключ (.pub)"/>
                <Button Grid.Column="1"
                        Content="Вибрати..."
                        Command="{Binding SelectPublicKeyCommand}"
                        Margin="5,0,0,0"/>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="Файл для шифрування:" Foreground="White"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding InputFilePath}"
                        IsReadOnly="True"
                        Watermark="Виберіть файл для шифрування"/>
                <Button Grid.Column="1"
                        Content="Вибрати..."
                        Command="{Binding SelectInputFileCommand}"
                        Margin="5,0,0,0"/>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="Зашифрований файл буде збережено як:" Foreground="White"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding OutputFilePath}"
                        IsReadOnly="True"
                        Watermark="Виберіть місце збереження"/>
                <Button Grid.Column="1"
                        Content="Вибрати..."
                        Command="{Binding SelectOutputFileCommand}"
                        Margin="5,0,0,0"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Режим дешифрування -->
        <Border Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="15"
                IsVisible="{Binding IsDecryptMode}">
          <StackPanel Spacing="12">
            <TextBlock Text="Налаштування дешифрування:" FontWeight="SemiBold" Foreground="White"/>
            
            <StackPanel Spacing="5">
              <TextBlock Text="Приватний ключ:" Foreground="White"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding KeyFilePath}"
                        IsReadOnly="True"
                        Watermark="Виберіть приватний ключ"/>
                <Button Grid.Column="1"
                        Content="Вибрати..."
                        Command="{Binding SelectPrivateKeyCommand}"
                        Margin="5,0,0,0"/>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="Зашифрований файл:" Foreground="White"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding InputFilePath}"
                        IsReadOnly="True"
                        Watermark="Виберіть зашифрований файл"/>
                <Button Grid.Column="1"
                        Content="Вибрати..."
                        Command="{Binding SelectInputFileCommand}"
                        Margin="5,0,0,0"/>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="Розшифрований файл буде збережено як:" Foreground="White"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                        Text="{Binding OutputFilePath}"
                        IsReadOnly="True"
                        Watermark="Виберіть місце збереження"/>
                <Button Grid.Column="1"
                        Content="Вибрати..."
                        Command="{Binding SelectOutputFileCommand}"
                        Margin="5,0,0,0"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <Button Command="{Binding GenerateKeysCommand}"
                  Width="450"
                  Height="45"
                  FontSize="16"
                  FontWeight="SemiBold"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  IsVisible="{Binding IsGenerateMode}">
            <TextBlock Text="Згенерувати ключі RSA" Foreground="Black"/>
          </Button>
          <Button Command="{Binding EncryptFileCommand}"
                  Width="450"
                  Height="45"
                  FontSize="16"
                  FontWeight="SemiBold"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  IsVisible="{Binding IsEncryptMode}">
            <TextBlock Text="Зашифрувати файл" Foreground="Black"/>
          </Button>
          <Button Command="{Binding DecryptFileCommand}"
                  Width="450"
                  Height="45"
                  FontSize="16"
                  FontWeight="SemiBold"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  IsVisible="{Binding IsDecryptMode}">
            <TextBlock Text="Розшифрувати файл" Foreground="Black"/>
          </Button>
        </StackPanel>

        <Border Background="#1E1E1E" 
                CornerRadius="6" 
                Padding="15"
                IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="8">
            <TextBlock Text="Статус:" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="{Binding Message}"
                      TextWrapping="Wrap"
                      Foreground="LightGray"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
          <Button Content="Повернутися до меню"
                  Command="{Binding GoBackCommand}"
                  Width="450"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
